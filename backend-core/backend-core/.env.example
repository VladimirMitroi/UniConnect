# ============================================================
# UniConnect Backend Core - Environment Variables
# ============================================================
# Copiaza acest fisier ca `.env` si completeaza valorile reale.
# NU comite fisierul `.env` pe GitHub!

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/uniconnect_db
DB_USERNAME=uniconnect_user
DB_PASSWORD=uniconnect_password

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- MinIO ---
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=uniconnect-documents

# --- JWT ---
# Genereaza un secret random cu: openssl rand -hex 32
JWT_SECRET_KEY=your_very_long_random_hex_secret_key_here
