# ============================================================
# UniConnect Docker Compose - Environment Variables
# ============================================================
# Copiaza acest fisier ca `docker-compose.env` si completeaza valorile reale.
# NU comite fisierul `docker-compose.env` pe GitHub!

# --- PostgreSQL ---
POSTGRES_USER=uniconnect_user
POSTGRES_PASSWORD=uniconnect_password
POSTGRES_DB=uniconnect_db

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@uniconnect.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
